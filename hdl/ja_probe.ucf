# Pmod JA probe: pins 1-4 (top row) and 7-10 (bottom row), all pulled up
NET "clk50" LOC = "B8";
NET "Ja<0>" LOC = "L15" | PULLUP;   # JA pin 1
NET "Ja<1>" LOC = "K12" | PULLUP;   # JA pin 2
NET "Ja<2>" LOC = "L17" | PULLUP;   # JA pin 3
NET "Ja<3>" LOC = "M15" | PULLUP;   # JA pin 4
NET "Ja<4>" LOC = "K13" | PULLUP;   # JA pin 7
NET "Ja<5>" LOC = "L16" | PULLUP;   # JA pin 8
NET "Ja<6>" LOC = "M14" | PULLUP;   # JA pin 9
NET "Ja<7>" LOC = "M16" | PULLUP;   # JA pin 10
NET "Btn<0>" LOC = "B18";
NET "Btn<1>" LOC = "D18";
NET "Btn<2>" LOC = "E18";
NET "Btn<3>" LOC = "H13";
NET "Seg<0>" LOC = "L18";
NET "Seg<1>" LOC = "F18";
NET "Seg<2>" LOC = "D17";
NET "Seg<3>" LOC = "D16";
NET "Seg<4>" LOC = "G14";
NET "Seg<5>" LOC = "J17";
NET "Seg<6>" LOC = "H14";
NET "Seg<7>" LOC = "C17";
NET "An<0>"  LOC = "F17";
NET "An<1>"  LOC = "H17";
NET "An<2>"  LOC = "C18";
NET "An<3>"  LOC = "F15";
NET "Led<0>" LOC = "J14";
NET "Led<1>" LOC = "J15";
NET "Led<2>" LOC = "K15";
NET "Led<3>" LOC = "K14";
